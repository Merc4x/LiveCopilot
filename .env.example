# ==============================================================================
# LiveCopilot - Configuración de Variables de Entorno
# ==============================================================================

# API Key de Groq (Requerido para STT Whisper Cloud de ultra-baja latencia y LLM)
# Consigue tu API Key gratuita en: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# API Key de Google Gemini (Opcional, alternativo para el LLM)
# Consigue tu API Key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Modo de Transcripción (STT):
# 'cloud' -> Utiliza Groq API (whisper-large-v3, latencia típica <300ms)
# 'local' -> Utiliza faster-whisper en local (CUDA o CPU)
STT_MODE=cloud

# Habilitar conmutación automática a local si la nube falla o excede timeout:
FALLBACK_TO_LOCAL=true

# Proveedor de LLM para Sugerencias en Vivo:
# 'groq'   -> llama-3.3-70b-versatile o llama-3.1-8b-instant (ultra-baja latencia)
# 'gemini' -> gemini-2.5-flash / gemini-2.0-flash
LLM_PROVIDER=groq

# Modelo local de Whisper en caso de fallback o modo local (base, small, tiny)
LOCAL_WHISPER_MODEL=base

# Dispositivo para computación local ('cuda' o 'cpu')
LOCAL_DEVICE=cpu

# Tipo de cómputo para faster-whisper ('float16' para GPU CUDA, 'int8' para CPU)
LOCAL_COMPUTE_TYPE=int8

# Detección de Actividad de Voz (VAD):
# Tiempo de silencio en milisegundos tras el cual se procesa la frase (defecto: 1800 ms para oraciones completas)
VAD_SILENCE_TIMEOUT_MS=1800

# Umbral de probabilidad de voz para Silero VAD (0.1 a 0.9, defecto: 0.4)
VAD_THRESHOLD=0.4

# Duración mínima de habla para evitar procesar chasquidos o ruidos breves (segundos)
MIN_SPEECH_DURATION_SEC=0.6

# Idioma de transcripción / traducción ('es' para español)
TARGET_LANGUAGE=es
