# ==============================================================================
# LiveCopilot - Environment Variables Configuration Template
# ==============================================================================

# Groq API Key (Required for ultra-low latency Whisper Cloud STT and Llama-3.3 LLM)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key (Optional alternative LLM provider)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Speech-to-Text (STT) Mode:
# 'cloud' -> Uses Groq API (whisper-large-v3, typical latency <300ms)
# 'local' -> Uses faster-whisper locally (CTranslate2 CUDA or CPU)
STT_MODE=cloud

# Automatically fallback to local Whisper if the cloud request fails or times out:
FALLBACK_TO_LOCAL=true

# Conversational LLM Provider for Live Suggestions:
# 'groq'   -> llama-3.3-70b-versatile or llama-3.1-8b-instant (ultra-low latency)
# 'gemini' -> gemini-2.5-flash / gemini-2.0-flash
LLM_PROVIDER=groq

# ------------------------------------------------------------------------------
# Multilingual Co-Pilot Configuration:
# ------------------------------------------------------------------------------
# User's primary native language (the language you understand best):
# All heard speech translations and response meanings will be in this language.
# Examples: 'Spanish', 'English', 'Portuguese', 'French', 'German', 'Italian', 'Japanese', 'Chinese'
USER_NATIVE_LANG=Spanish

# Default target language you want to speak back in:
# Can also be switched dynamically on the fly directly in the HUD interface!
# Examples: 'English', 'Chinese (Mandarin)', 'Spanish', 'French', 'German', 'Japanese', 'Portuguese'
RESPONSE_LANG=English

# Local Whisper model for offline/fallback mode ('tiny', 'base', 'small')
LOCAL_WHISPER_MODEL=base

# Device for local computation ('cuda' or 'cpu')
LOCAL_DEVICE=cpu

# Compute type for faster-whisper ('float16' for GPU CUDA, 'int8' for CPU)
LOCAL_COMPUTE_TYPE=int8

# Voice Activity Detection (VAD):
# Silence timeout in milliseconds before processing a complete speech segment (default: 1800 ms)
VAD_SILENCE_TIMEOUT_MS=1800

# Voice probability threshold for Silero-VAD (0.1 to 0.9, default: 0.4)
VAD_THRESHOLD=0.4

# Minimum speech duration to prevent processing brief clicks or pops (seconds)
MIN_SPEECH_DURATION_SEC=0.6

# Spoken audio speech recognition language ('auto' to autodetect 99 languages, or 'en', 'es', 'zh')
TARGET_LANGUAGE=auto

# Audio Output Device ID (Soundcard loopback device ID, leave blank for system default)
AUDIO_DEVICE_ID=
